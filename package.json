{
  "name": "electron-autoupdate-demo",
  "version": "0.1.0",
  "description": "Electron auto-update demo with electron-builder and electron-updater",
  "private": true,
  "main": "src/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder",
    "release": "electron-builder --publish always",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.example.electronautoupdatedemo",
    "productName": "Electron AutoUpdate Demo",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wood3n",
        "repo": "electron-autoupdate-demo",
        "releaseType": "release"
      }
    ]
  }
}
